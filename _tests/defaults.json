{
    "definition": {
        "name": "defaults",
        "title": "Default list",
        "inputs": [
            {
                "kind": "input",
                "name": "quantities",
                "type": "regex-list",
                "label": "Components",
                "default": "Product\tQuantity\nITEM-A\t0,500 kg\nITEM-B\t0,060 kg\nITEM-C\t0,040 kg",
                "pattern": "(?<value>[+-]?\\d+(?:[.,]\\d+)?)(?=\\s+kg(?:\\s|$))",
                "flags": "iu",
                "min": 0,
                "break": true
            }
        ],
        "outputs": [
            {
                "kind": "output",
                "name": "total",
                "label": "Total",
                "formula": "sum(quantities)",
                "type": "decimal",
                "decimals": 3,
                "fixed": false
            }
        ],
        "constants": [],
        "showwork": false
    },
    "decimal": {
        "name": "defaults",
        "title": "Numbers",
        "inputs": [
            {
                "kind": "input",
                "name": "quantities",
                "type": "decimal-list",
                "label": "Numbers",
                "min": 0,
                "max": 10,
                "default": "1.5\n\n 2,5 \n0"
            }
        ],
        "outputs": [
            {
                "kind": "output",
                "name": "total",
                "label": "Total",
                "formula": "sum(quantities)",
                "type": "decimal",
                "decimals": 3,
                "fixed": false
            }
        ],
        "constants": [],
        "showwork": false
    },
    "scalar": {
        "name": "defaults",
        "title": "Scalar",
        "inputs": [
            {
                "kind": "input",
                "name": "number",
                "type": "decimal",
                "label": "Number",
                "default": 2.5
            }
        ],
        "outputs": [
            {
                "kind": "output",
                "name": "result",
                "label": "Result",
                "formula": "number",
                "type": "decimal",
                "decimals": 3,
                "fixed": false
            }
        ],
        "constants": [],
        "showwork": false
    }
}